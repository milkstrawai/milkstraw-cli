{
  "name": "@milkstraw/cli",
  "version": "0.1.0",
  "description": "MilkStraw AI CLI - AI-powered cloud cost optimization",
  "type": "module",
  "bin": {
    "milkstraw": "bin/milkstraw.js"
  },
  "files": [
    "dist/",
    "bin/"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:int": "vitest run tests/integration",
    "lint": "biome check src/ tests/",
    "lint:fix": "biome check --write src/ tests/",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@aws-sdk/client-cloudformation": "^3.1006.0",
    "@aws-sdk/client-organizations": "^3.1006.0",
    "@aws-sdk/client-sts": "^3.1006.0",
    "@inquirer/prompts": "^7.0.0",
    "chalk": "^5.3.0",
    "commander": "^13.0.0",
    "open": "^10.1.0",
    "ora": "^8.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.6",
    "@types/node": "^22.19.17",
    "@vitest/coverage-v8": "^3.2.4",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "author": "MilkStraw AI <admin@milkstraw.ai>",
  "repository": {
    "type": "git",
    "url": "https://github.com/milkstrawai/milkstraw-cli.git"
  },
  "homepage": "https://www.milkstraw.ai",
  "bugs": {
    "url": "https://github.com/milkstrawai/milkstraw-cli/issues"
  },
  "keywords": [
    "aws",
    "cloud",
    "cost-optimization",
    "cloudformation",
    "cli"
  ]
}
